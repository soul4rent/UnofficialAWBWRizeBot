{
  "manifest_version": 2,
  "name": "Unofficial AWBW Rize Bot",
  "version": "0.3.0",
  "description": "Plays a seat you control in an Advance Wars By Web game using DefendPeace's AI logic. Frontend only; no changes to AWBW.",
  "icons": {
    "48": "res/icon48.png",
    "96": "res/icon96.png"
  },
  "content_scripts": [
    {
      "matches": ["https://awbw.amarriner.com/game.php*"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["page/bot.js"],
  "permissions": ["https://awbw.amarriner.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "unofficial-awbw-rize-bot@localhost",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
